{
  "expo": {
    "name": "Weatly",
    "slug": "weatly",
    "version": "1.5.1",
    "scheme": "cookplanner",
    "orientation": "portrait",
    "icon": "./assets/images/book-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jbdg.weatly",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jbdg.weatly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/book-icon.png",
        "backgroundColor": "#BB6F2B"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3feace34-737f-4703-bd5e-3e72d218818b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3feace34-737f-4703-bd5e-3e72d218818b"
    },
    "owner": "jb-dg"
  }
}
