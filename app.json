{
  "expo": {
    "name": "Weatly",
    "slug": "weatly",
    "version": "1.6.0",
    "description": "Planificateur de repas, recettes et liste de courses pour organiser la cuisine du foyer.",
    "scheme": "cookplanner",
    "orientation": "portrait",
    "icon": "./assets/images/book-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/book-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.jbdg.weatly",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/book-icon.png",
      "package": "com.jbdg.weatly",
      "versionCode": 151,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/book-icon.png",
        "backgroundColor": "#BB6F2B"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Weatly utilise vos photos pour ajouter une image a votre profil ou a vos recettes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/book-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F1"
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3feace34-737f-4703-bd5e-3e72d218818b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3feace34-737f-4703-bd5e-3e72d218818b"
    },
    "owner": "jb-dg"
  }
}
